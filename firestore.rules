rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(shop) { return get(/databases/$(database)/documents/shops/$(shop)/members/$(request.auth.uid)); }
    function member(shop) { return signedIn() && exists(/databases/$(database)/documents/shops/$(shop)/members/$(request.auth.uid)); }
    function owner(shop) { return signedIn() && membership(shop).data.role == 'owner'; }
    function money(v) { return v is int && v >= 0 && v <= 9000000000000; }
    function nonempty(v) { return v is string && v.size() > 0 && v.size() <= 300; }
    function endpoint(e, shop) {
      return e is map && e.keys().hasOnly(['kind','id']) &&
        (e.kind in ['inventory','walkIn'] ? e.id == null : e.id is string &&
          (e.kind == 'godam' ? exists(/databases/$(database)/documents/shops/$(shop)/records/$('godams_' + e.id)) :
            e.kind in ['farmer','supplier'] &&
              get(/databases/$(database)/documents/shops/$(shop)/records/$('people_' + e.id)).data.payload.kind == e.kind));
    }
    function internal(e) { return e.kind in ['inventory','godam']; }
    function person(e) { return e.kind in ['farmer','supplier']; }
    function entry(p, shop) {
      let amountEntry = p.kind in ['cash','other'];
      let fromInternal = internal(p.source);
      let toInternal = internal(p.destination);
      let direct = person(p.source) && person(p.destination);
      let transfer = fromInternal && toInternal;
      let total = p.ratePending || transfer ? 0 : (amountEntry ? p.amountPaise : math.round(p.quantity * p.ratePaise));
      // The Dart domain uses exact decimal half-up arithmetic. Rules use binary
      // numbers, so allow one paisa of representation tolerance for qty × rate.
      let tolerance = amountEntry ? 0 : 1;
      let external = fromInternal ? p.destination : p.source;
      let cropPricing = p.get('cropPricing',false);
      // Access/type checks below require all mandatory fields. Avoid a duplicate
      // hasAll scan so complex rate edits stay within Firestore's expression cap.
      return p.keys().hasOnly(['id','kind','source','destination','date','itemId','title','note','batch','expiry','quantity','unit','unitFactor',
          'ratePaise','purchasePaise','salePaise','cashPaise','amountPaise','ratePending','expenseCategory','createdBy','createdAt','voided','allocations','cropPricing','purchaseRatePending']) &&
        cropPricing is bool && p.get('purchaseRatePending',false) is bool &&
        (!p.get('purchaseRatePending',false) || cropPricing && direct) &&
        p.get('allocations',[]) is list && p.get('allocations',[]).size() <= 1000 &&
        (p.get('allocations',[]).size() == 0 || p.kind in ['product','crop'] && fromInternal) &&
        p.kind in ['cash','product','crop','diesel','other'] && p.date is string && (p.itemId == null || p.itemId is string) &&
        p.title is string && p.title.size() <= 300 && p.note is string && p.note.size() <= 4000 &&
        p.batch is string && p.batch.size() <= 200 && p.unit is string && p.expenseCategory is string &&
        p.ratePending is bool && p.voided is bool && p.createdBy is string && p.createdAt is int && p.createdAt > 0 &&
        endpoint(p.source,shop) && endpoint(p.destination,shop) && p.source != p.destination &&
        (fromInternal || toInternal || direct) &&
        p.quantity is number && p.quantity > 0 && p.quantity <= 1000000000 &&
        p.unitFactor is number && p.unitFactor > 0 && p.unitFactor <= 1000000000 &&
        (cropPricing ? cropEntryMoney(p,fromInternal,toInternal,direct,total) :
          money(p.ratePaise) && money(p.purchasePaise) && money(p.salePaise) && money(p.cashPaise) && money(p.amountPaise) &&
          (p.ratePending || p.cashPaise <= total + tolerance) && total <= 9000000000000 &&
          (!p.ratePending || p.kind in ['product','crop','diesel']) &&
          (!transfer || p.kind in ['product','crop'] && p.cashPaise == 0 && !p.ratePending) &&
          (p.kind != 'cash' || p.amountPaise > 0 && p.cashPaise == 0) &&
          (p.kind != 'other' || (fromInternal || direct) && p.title.size() > 0 && p.amountPaise > 0 && p.cashPaise == p.amountPaise) &&
          (p.kind != 'diesel' || fromInternal || direct) &&
          (p.kind == 'cash' || p.ratePending || transfer || total > 0) &&
          (transfer || person(external) || p.kind == 'cash' || !p.ratePending && math.abs(p.cashPaise - total) <= tolerance)) &&
        (!(p.kind in ['product','crop']) || p.itemId is string &&
          get(/databases/$(database)/documents/shops/$(shop)/records/$('products_' + p.itemId)).data.payload.kind == p.kind) &&
        (p.expiry == null || p.expiry is string) &&
        (p.kind != 'product' || !fromInternal && !toInternal || p.batch.size() > 0 || fromInternal && p.get('allocations',[]).size() > 0);
    }
    function cropEntryMoney(p,fromInternal,toInternal,direct,total) {
      let transfer = fromInternal && toInternal;
      let purchasePending = direct ? p.get('purchaseRatePending',false) : p.ratePending;
      let purchaseTotal = purchasePending ? 0 : math.round(p.quantity * p.purchasePaise);
      return p.kind == 'crop' &&
        p.ratePaise is int &&
        money(p.purchasePaise) && money(p.salePaise) && money(p.cashPaise) && money(p.amountPaise) &&
        p.ratePaise == (p.ratePending || transfer ? 0 : (toInternal ? p.purchasePaise : p.salePaise)) &&
        (!toInternal || p.salePaise == 0) &&
        (fromInternal || purchasePending || purchaseTotal > 0 && purchaseTotal <= 9000000000000 && p.cashPaise <= purchaseTotal + 1) &&
        total <= 9000000000000 && (p.ratePending || p.cashPaise <= total + 1) &&
        (p.ratePending || transfer || total > 0) &&
        (!transfer || p.cashPaise == 0 && !p.ratePending) &&
        (transfer || direct || person(fromInternal ? p.destination : p.source) || !p.ratePending && math.abs(p.cashPaise - total) <= 1);
    }
    function cropPrices(p,transfer) {
      let purchasePending = person(p.source) && person(p.destination) ? p.get('purchaseRatePending',false) : p.ratePending;
      let purchaseTotal = purchasePending ? 0 : math.round(p.quantity * p.purchasePaise);
      return p.kind == 'crop' &&
        (transfer || p.ratePaise == (p.ratePending ? 0 : (internal(p.destination) ? p.purchasePaise : p.salePaise))) &&
        (!internal(p.destination) || p.salePaise == 0) &&
        (internal(p.source) || transfer || purchasePending || purchaseTotal > 0 && purchaseTotal <= 9000000000000 && p.cashPaise <= purchaseTotal + 1);
    }
    function validPayload(d, shop) {
      let p = d.payload;
      return p is map && p.id == d.id &&
        (d.entity == 'entries' && entry(p,shop) ||
          d.entity == 'people' && p.keys().hasOnly(['id','name','kind','phone','village','acres','crops']) &&
            nonempty(p.name) && p.kind in ['farmer','supplier'] && p.phone is string && p.village is string &&
            p.acres is number && p.acres >= 0 && p.crops is string ||
          d.entity == 'products' && p.keys().hasOnly(['id','name','company','crop','pest','kind','baseUnit','units','lowStock','purchasePaise','salePaise']) &&
            nonempty(p.name) && p.company is string && p.crop is string && p.pest is string && p.kind in ['product','crop'] &&
            p.units is map && p.units.size() <= 30 && nonempty(p.baseUnit) && p.units[p.baseUnit] == 1 &&
            p.lowStock is number && p.lowStock >= 0 && money(p.purchasePaise) && money(p.salePaise) ||
          d.entity == 'godams' && p.keys().hasOnly(['id','name','address']) && nonempty(p.name) && p.address is string ||
          d.entity == 'rates' && p.keys().hasOnly(['id','itemId','date','purchasePaise','salePaise']) &&
            p.itemId is string && p.date is string && money(p.purchasePaise) && money(p.salePaise));
    }
    function envelope(d, shop, record) {
      return d.keys().hasOnly(['id','entity','shopId','payload','updatedAt','deviceId','deleted','committedAt']) &&
        nonempty(d.id) && d.entity in ['people','products','godams','entries','rates'] &&
        record == d.entity + '_' + d.id && d.shopId == shop &&
        d.updatedAt is int && d.updatedAt > 0 && d.updatedAt <= request.time.toMillis() * 1000 + 300000000 &&
        nonempty(d.deviceId) && d.deleted is bool && d.committedAt == request.time;
    }
    // Entry parties, units, cash and stock allocations are immutable on update.
    // Validate only permitted financial changes; repeating endpoint lookups and
    // full creation validation would exceed the 1,000-expression rules budget.
    function entryRateValues(p) {
      let transfer = internal(p.source) && internal(p.destination);
      let total = p.ratePending || transfer ? 0 :
        (p.kind in ['cash','other'] ? p.amountPaise : math.round(p.quantity * p.ratePaise));
      let external = internal(p.source) ? p.destination : p.source;
      return p.ratePending is bool && p.get('purchaseRatePending',false) is bool &&
        money(p.ratePaise) && money(p.purchasePaise) && money(p.salePaise) &&
        total <= 9000000000000 && (p.ratePending || p.cashPaise <= total + 1) &&
        (!p.ratePending || p.kind in ['product','crop','diesel']) &&
        (!transfer || !p.ratePending) &&
        (transfer || person(external) || p.kind == 'cash' || !p.ratePending && math.abs(p.cashPaise - total) <= 1) &&
        (p.kind == 'cash' || p.ratePending || transfer || total > 0) &&
        (!p.get('cropPricing',false) || cropPrices(p,transfer));
    }
    // The REST client resolves equal timestamps by lexicographic device ID under
    // an updateTime precondition. Rules reject older timestamps independently.
    function newer(a,b) { return a.updatedAt > b.updatedAt || a.updatedAt == b.updatedAt && a.deviceId != b.deviceId; }
    function entryUpdate(a,b,shop) {
      return a == b ||
        (a.get('cropPricing',false) && b.get('cropPricing',false)
          ? cropEntryUpdate(a,b,shop)
          : a.diff(b).affectedKeys().hasOnly(['ratePaise','ratePending','voided']) &&
        ((!b.voided && !a.voided && b.ratePending && !a.ratePending) ||
          owner(shop) && !a.voided && !b.voided && !a.ratePending ||
          owner(shop) && !b.voided && a.voided && a.ratePaise == b.ratePaise && a.ratePending == b.ratePending));
    }
    function cropEntryUpdate(a,b,shop) {
      let purchaseWasPending = person(b.source) && person(b.destination) ? b.get('purchaseRatePending',false) : !internal(b.source) && b.ratePending;
      return owner(shop) && !b.voided && a.voided && a.diff(b).affectedKeys().hasOnly(['voided']) ||
        !a.voided && !b.voided &&
        a.diff(b).affectedKeys().hasOnly(['ratePaise','ratePending','purchasePaise','salePaise','purchaseRatePending']) &&
        (!a.ratePending || b.ratePending) &&
        (!a.get('purchaseRatePending',false) || b.get('purchaseRatePending',false)) &&
        (owner(shop) ||
          (b.ratePending || a.ratePaise == b.ratePaise && a.salePaise == b.salePaise) &&
          (purchaseWasPending || a.purchasePaise == b.purchasePaise) &&
          (b.ratePending && !a.ratePending || b.get('purchaseRatePending',false) && !a.get('purchaseRatePending',false)));
    }
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /shops/{shop} {
      allow read: if member(shop);
      allow write: if false;
      match /members/{uid} { allow read: if member(shop); allow write: if false; }
      match /records/{record} {
        allow read: if member(shop);
        allow create: if member(shop) &&
          !request.resource.data.deleted &&
          (request.resource.data.entity != 'entries' ||
            (request.resource.data.payload.createdBy == request.auth.uid || owner(shop)) &&
              (!request.resource.data.payload.voided || owner(shop))) &&
          envelope(request.resource.data,shop,record) && validPayload(request.resource.data,shop);
        allow update: if member(shop) &&
          request.resource.data.id == resource.data.id && request.resource.data.entity == resource.data.entity &&
          newer(request.resource.data,resource.data) &&
          (!request.resource.data.deleted || owner(shop)) &&
          (resource.data.entity != 'entries' || !request.resource.data.deleted && entryUpdate(request.resource.data.payload,resource.data.payload,shop)) &&
          (resource.data.entity != 'rates' || request.resource.data.payload == resource.data.payload) &&
          envelope(request.resource.data,shop,record) &&
          (resource.data.entity == 'entries' ? entryRateValues(request.resource.data.payload) : validPayload(request.resource.data,shop));
        allow delete: if false;
      }
    }
    // Secrets, invitations, OTPs and rate-limit records are Admin SDK only.
    match /{document=**} { allow read, write: if false; }
  }
}
